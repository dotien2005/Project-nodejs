extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-3
    .row
      .col-12
        a(
          class="btn btn-primary m-1"
          href="/users/not-friend"
        ) Danh sách người dùng

        a(
          class="btn btn-primary m-1"
          href="/users/friends"
        ) Danh sách bạn bè

        a(
          class="btn btn-primary m-1"
          href="/users/request"
        ) Lời mời đã gửi

        a(
          class="btn btn-primary m-1"
          href="/users/accept"
        ) Lời mời kết bạn



    .row
      .col-12
        +box-head("Chat")


    .row
      .col-12
        .chat(my-id=user.id)
          //- .inner-head
          //-   .inner-avatar EY
          //-   .inner-name Em Yêu

          .inner-body
            each chat in chats
              div(class=(chat.user_id == user.id ? "inner-outgoing" : "inner-incoming"))
                if(chat.user_id != user.id)
                  .inner-name #{chat.infoUser.fullName}
                .inner-content
                  | #{chat.content}

            //- typing
            div(class="inner-list-typing")
              div(class="box-typing")
                div(class="inner-name") Em Yêu
                div(class="inner-dots")
                  span
                  span
                  span

          .inner-foot
            form(
              class="inner-form"
              action="#"
            )
              input(
                type="text"
                class="inner-input"
                placeholder="Nhập tin nhắn..."
                name="content"
              )
              div(
                class="custom-file-container"
                data-upload-id="upload-images"
              )
              span(class="button-icon btn btn-light mx-2") <i class="fa-solid fa-face-smile"></i>
              button(
                type="submit"
                class="inner-btn"
              )
                i.fas.fa-paper-plane

  div(class="tooltip" role="tooltip")
    emoji-picker(class="light")